{
	"name": "jeo",
	"version": "3.0.0-rc.3",
	"description": "Interactive maps for the WordPress block editor",
	"main": "index.js",
	"directories": {
		"test": "tests"
	},
	"engines": {
		"node": "^24.0.0",
		"npm": ">=10"
	},
	"scripts": {
		"check:env": "node scripts/check-node-version.mjs",
		"preinstall": "node scripts/check-node-version.mjs",
		"sync:version": "node scripts/sync-plugin-version.mjs",
		"check:wporg-compliance": "node scripts/check-wporg-compliance.mjs",
		"start": "wp-scripts start",
		"build:assets": "wp-scripts build && node scripts/patch-build-compliance.mjs",
		"i18n:json": "node scripts/make-i18n-json.mjs",
		"build": "npm run build:assets && npm run i18n:json",
		"build:release": "npm run build",
		"build:report": "node scripts/report-bundle-sizes.mjs",
		"test:unit": "wp-scripts test-unit-js",
		"audit:npm": "npm audit --package-lock-only",
		"audit:composer": "composer audit --locked",
		"deps:report": "node scripts/dependency-review.mjs --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/InfoAmazonia/jeo-plugin.git"
	},
	"author": {
		"name": "InfoAmazonia",
		"email": "contact@infoamazonia.org",
		"url": "https://www.jeowp.org/"
	},
	"license": "GPL-3.0-only",
	"bugs": {
		"url": "https://github.com/InfoAmazonia/jeo-plugin/issues"
	},
	"homepage": "https://www.jeowp.org/",
	"overrides": {
		"react-autosize-textarea": "file:npm-overrides/react-autosize-textarea",
		"webpack-dev-server": "^5.2.4",
		"markdownlint-cli": "^0.48.0",
		"copy-webpack-plugin": "^14.0.0"
	},
	"dependencies": {
		"@ckeditor/ckeditor5-react": "^11.1.2",
		"@nazka/map-gl-js-spiderfy": "^2.0.0",
		"@rjsf/core": "^6.5.3",
		"@rjsf/validator-ajv8": "^6.5.3",
		"@wordpress/api-fetch": "^7.46.0",
		"@wordpress/block-editor": "^15.19.0",
		"@wordpress/blocks": "^15.19.0",
		"@wordpress/components": "^33.1.0",
		"@wordpress/compose": "^7.46.0",
		"@wordpress/core-data": "^7.46.0",
		"@wordpress/data": "^10.46.0",
		"@wordpress/dom-ready": "^4.46.0",
		"@wordpress/editor": "^14.46.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/html-entities": "^4.46.0",
		"@wordpress/i18n": "^6.19.0",
		"@wordpress/icons": "^13.1.0",
		"@wordpress/media-utils": "^5.46.0",
		"@wordpress/plugins": "^7.46.0",
		"@wordpress/url": "^4.46.0",
		"ckeditor5": "^48.1.1",
		"classnames": "^2.5.1",
		"date-fns": "^4.2.1",
		"eta": "^4.6.0",
		"leaflet": "^1.9.4",
		"lodash-es": "^4.17.23",
		"map-gl-utils": "^0.50.4",
		"maplibre-gl": "^5.24.0",
		"maplibregl-mapbox-request-transformer": "^0.0.3",
		"react-datepicker": "^9.1.0",
		"react-leaflet": "^4.2.1",
		"react-map-gl": "^8.1.1",
		"react-movable": "^3.4.0",
		"scrollama": "^3.2.0",
		"use-debounce": "^10.1.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^32.2.0"
	}
}
