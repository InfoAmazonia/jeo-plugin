{
	"name": "jeowp",
	"version": "4.0.0-beta.1",
	"description": "Interactive maps for the WordPress block editor",
	"main": "index.js",
	"directories": {
		"test": "tests"
	},
	"engines": {
		"node": "^24.0.0",
		"npm": ">=10"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=10",
			"onFail": "error"
		}
	},
	"scripts": {
		"sync:version": "node scripts/sync-plugin-version.mjs",
		"start": "wp-scripts start",
		"build:assets": "wp-scripts build && node scripts/patch-build-compliance.mjs",
		"i18n:pot": "wp i18n make-pot src src/languages/jeowp.pot --slug=jeowp --domain=jeowp --exclude=js/src",
		"i18n:po": "wp i18n update-po src/languages/jeowp.pot src/languages",
		"i18n:mo": "wp i18n make-mo src/languages",
		"i18n:php": "wp i18n make-php src/languages",
		"i18n:json": "wp i18n make-json src/languages --no-purge",
		"i18n:compile": "npm run i18n:mo && npm run i18n:php && npm run i18n:json",
		"i18n:refresh": "npm run build:assets && npm run i18n:pot && npm run i18n:po",
		"build": "npm run build:assets && npm run i18n:compile",
		"build:site": "npm --prefix landing-page install --no-audit --no-fund && npm --prefix landing-page run build && npm --prefix docs install --no-audit --no-fund && npm --prefix docs run docs:build",
		"dev:site": "node scripts/dev-site.mjs",
		"preview:site": "python3 -m http.server 4174 --directory site",
		"build:release": "npm run build",
		"build:report": "size-limit",
		"test:unit": "wp-scripts test-unit-js",
		"audit:npm": "npm audit --package-lock-only",
		"audit:composer": "composer audit --locked"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/InfoAmazonia/jeo-plugin.git"
	},
	"author": {
		"name": "InfoAmazonia",
		"email": "contact@infoamazonia.org",
		"url": "https://www.jeowp.org/"
	},
	"license": "GPL-3.0-only",
	"bugs": {
		"url": "https://github.com/InfoAmazonia/jeo-plugin/issues"
	},
	"homepage": "https://www.jeowp.org/",
	"overrides": {
		"react-autosize-textarea": "file:npm-overrides/react-autosize-textarea",
		"copy-webpack-plugin": "^14.0.0"
	},
	"dependencies": {
		"@ckeditor/ckeditor5-react": "^12.0.0",
		"@nazka/map-gl-js-spiderfy": "^2.0.0",
		"@rjsf/core": "^6.5.3",
		"@rjsf/validator-ajv8": "^6.5.3",
		"@wordpress/editor": "^14.46.0",
		"ckeditor5": "^49.0.0",
		"classnames": "^2.5.1",
		"date-fns": "^4.2.1",
		"eta": "^4.6.0",
		"leaflet": "^1.9.4",
		"lodash-es": "^4.17.23",
		"map-gl-utils": "^0.50.4",
		"maplibre-gl": "^6.15.0",
		"maplibregl-mapbox-request-transformer": "^0.0.3",
		"react-bootstrap-daterangepicker": "^8.0.0",
		"react-datepicker": "^9.1.0",
		"react-leaflet": "^4.2.1",
		"react-map-gl": "^8.1.2",
		"react-movable": "^3.4.0",
		"scrollama": "^3.2.0",
		"use-debounce": "^10.1.0"
	},
	"devDependencies": {
		"@size-limit/file": "^14.3.0",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@wordpress/scripts": "^37.0.0",
		"ajv": "^8.18.0",
		"copy-webpack-plugin": "^14.0.0",
		"css-loader": "^7.1.4",
		"jsdom": "^30.1.3",
		"postcss": "^8.5.26",
		"sass": "^1.98.0",
		"sass-loader": "^17.0.1",
		"size-limit": "^14.2.0",
		"style-loader": "^4.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"webpack": "^5.105.4"
	}
}
